{
  "name": "DishSwapp — Open-source collaborative recipes",
  "short_name": "DishSwapp",
  "description": "Collect, collaborate, cook. An open-source community where home cooks discover, swap and improve recipes together.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FBF7F1",
  "theme_color": "#3D717C",
  "orientation": "portrait-primary",
  "lang": "en",
  "prefer_related_applications": false,
  "categories": ["food", "cooking", "lifestyle", "social"],
  "icons": [
    { "src": "/img/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Browse recipes",  "short_name": "Recipes",  "url": "/recipes/" },
    { "name": "My cookbook",     "short_name": "Cookbook", "url": "/cookbook" },
    { "name": "Add a recipe",    "short_name": "Add",       "url": "/submit-recipe" }
  ]
}
