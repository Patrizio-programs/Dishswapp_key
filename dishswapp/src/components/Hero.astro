---
// src/components/Hero.astro
// DishSwapp homepage hero — recreates the gradient mockup.
//
//   • Sage → cream → peach diagonal gradient (sampled from the mockup).
//   • Large peachy-pink circle decoration on the right, bleeding off-edge.
//   • Eyebrow "Open-source recipes" — JetBrains Mono, uppercase, tracked (§07).
//   • Headline "Collect, collaborate, cook." — Playfair Display (§15 tagline),
//     with "cook." as a pink italic accent.
//   • Single spice CTA "Start exploring" — the one spice element per page (§16 note 3).
//
// Uses Bootstrap utility classes (container, position-relative, overflow-hidden, btn)
// plus scoped brand styles. Depends on the brand tokens + fonts from BaseLayout.

interface Props {
  /** Eyebrow label above the headline. */
  eyebrow?: string;
  /** Headline text. Use the <em> inside to mark the pink italic accent. */
  title?: string;
  /** CTA button label. */
  ctaLabel?: string;
  /** CTA link target. */
  ctaHref?: string;
}

const {
  eyebrow = 'Open-source recipes',
  title = 'Collect, collaborate, cook.',
  ctaLabel = 'Start exploring',
  ctaHref = '/recipes',
} = Astro.props;

// Split the title so the last word becomes the pink italic accent.
const words = title.trim().split(/\s+/);
const head = words.slice(0, -1).join(' ');
const accent = words[words.length - 1];
---

<section class="ds-hero position-relative overflow-hidden">
  <!-- Decorative peachy-pink circle — bleeds off the right edge -->
  <div class="ds-hero__circle" aria-hidden="true"></div>

  <div class="container position-relative">
    <div class="ds-hero__content">
      <p class="ds-hero__eyebrow">{eyebrow}</p>

      <h1 class="ds-hero__title">
        {head}<br />
        <em class="ds-hero__title-accent">{accent}</em>
      </h1>

      <a class="btn ds-hero__cta" href={ctaHref}>
        {ctaLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .ds-hero {
    background: linear-gradient(
      115deg,
      var(--ds-teal-dark) 0%,
      var(--ds-teal) 58%,
      var(--ds-teal-light) 100%
    );
    min-height: clamp(440px, 52vw, 660px);
    display: flex;
    align-items: center;
    padding: 4rem 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* Decorative circle — large, peachy pink, bleeds off the right edge */
  .ds-hero__circle {
    position: absolute;
    top: 50%;
    right: -200px;
    transform: translateY(-50%);
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: var(--ds-pink);
    opacity: 0.9;
    pointer-events: none;
  }

  /* Text block — left-aligned, capped for readability */
  .ds-hero__content {
    max-width: 34rem;
    position: relative;
    z-index: 2;
  }

  /* Eyebrow — JetBrains Mono, uppercase, tracked (§07) */
  .ds-hero__eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ds-white);
    margin: 0 0 1.25rem;
    text-shadow: 0 1px 2px rgba(44, 42, 40, 0.15);
  }

  /* Headline — Playfair Display 700, white (§07 / §15) */
  .ds-hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    color: var(--ds-white);
    margin: 0 0 2.25rem;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 8px rgba(44, 42, 40, 0.12);
  }

  /* The pink accent mirrors the wordmark's "Swapp". */
  .ds-hero__title-accent {
    font-style: italic;
    font-weight: 700;
    color: var(--ds-pink);
    text-shadow: 0 1px 6px rgba(44, 42, 40, 0.18);
  }

  /* The single spice accent on the home page. */
  .ds-hero__cta {
    background-color: var(--ds-spice);
    color: var(--ds-dark);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.7rem 1.85rem;
    border-radius: var(--ds-radius-md);
    border: none;
    box-shadow: 0 4px 12px rgba(44, 42, 40, 0.12);
    transition: background-color 0.2s ease, transform 0.15s ease,
      box-shadow 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }
  .ds-hero__cta:hover,
  .ds-hero__cta:focus-visible {
    background-color: var(--ds-teal-dark);
    color: var(--ds-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(44, 42, 40, 0.18);
  }

  @media (max-width: 991.98px) {
    .ds-hero {
      min-height: 420px;
      padding: 3rem 0;
    }
    .ds-hero__circle {
      width: 360px;
      height: 360px;
      right: -180px;
    }
  }

  @media (max-width: 575.98px) {
    .ds-hero {
      height: 100px;
      min-height: 100px;
      padding: 8px 0;
    }
    .ds-hero__circle {
      width: 150px;
      height: 150px;
      right: -85px;
      top: 50%;
      opacity: 0.25;
      transform: translateY(-50%);
    }
    .ds-hero__content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      max-width: none;
    }
    .ds-hero__eyebrow {
      display: none;
    }
    .ds-hero__title {
      max-width: 100%;
      margin: 0;
      font-size: clamp(1rem, 4.6vw, 1.2rem);
      line-height: 1.05;
      text-shadow: none;
    }
    .ds-hero__title-accent {
      color: var(--ds-pink);
    }
    .ds-hero__cta {
      padding: 0.55rem 0.75rem;
      font-size: 0.75rem;
      white-space: nowrap;
    }
  }
</style>
