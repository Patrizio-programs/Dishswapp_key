---
import type { Recipe } from '../lib/supabase';

interface Props {
  recipe: Recipe;
  href: string;
}

const { recipe, href } = Astro.props;

const {
  title,
  image_url,
  tags = [],
  difficulty,
  description,
  author,
  prep_time,
  cook_time,
  servings,
} = recipe;

const totalTime = (prep_time ?? 0) + (cook_time ?? 0);

const cuisine = tags[0];

const displayDifficulty =
  difficulty && difficulty !== 'none'
    ? difficulty.charAt(0).toUpperCase() + difficulty.slice(1)
    : null;
---

<a href={href} class="recipe-card">
  <div class="recipe-card__image-wrapper">
    {image_url ? (
      <img
        src={image_url}
        alt={title}
        class="recipe-card__image"
        loading="lazy"
      />
    ) : (
      <div class="recipe-card__placeholder">
        <span>DishSwapp</span>
      </div>
    )}
  </div>

  <div class="recipe-card__content">

    <div class="recipe-card__meta">
      {cuisine && (
        <span class="recipe-card__tag">{cuisine}</span>
      )}

      {totalTime > 0 && (
        <span class="recipe-card__time">
          <i class="bi bi-clock"></i>
          {totalTime} min
        </span>
      )}
    </div>

    <h3 class="recipe-card__title">{title}</h3>

    {description && (
      <p class="recipe-card__description">
        {description}
      </p>
    )}

    <div class="recipe-card__details">
      {author && (
        <span>
          <i class="bi bi-person"></i>
          {author}
        </span>
      )}

      {servings && (
        <span>
          <i class="bi bi-people"></i>
          {servings} servings
        </span>
      )}

      {displayDifficulty && (
        <span class="recipe-card__difficulty">
          {displayDifficulty}
        </span>
      )}
    </div>

  </div>
</a>

<style>
  .recipe-card {
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--ds-white);
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-md);
    color: var(--ds-dark);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .recipe-card:hover {
    color: var(--ds-dark);
    transform: translateY(-4px);
    border-color: var(--ds-pink);
    box-shadow: 0 10px 25px rgba(44, 52, 53, 0.09);
  }

  .recipe-card__image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ds-pink);
  }

  .recipe-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .recipe-card:hover .recipe-card__image {
    transform: scale(1.04);
  }

  .recipe-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(
      135deg,
      var(--ds-teal),
      #7D9B96
    );
    color: white;
    font-family: var(--ds-heading-font);
    font-size: 1.5rem;
  }

  .recipe-card__content {
    padding: 18px;
  }

  .recipe-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .recipe-card__tag {
    background: #E8F0EE;
    color: var(--ds-teal);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .recipe-card__time {
    color: var(--ds-muted);
    font-size: 0.8rem;
  }

  .recipe-card__time i {
    margin-right: 4px;
  }

  .recipe-card__title {
    font-family: var(--ds-heading-font);
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .recipe-card__description {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recipe-card__details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding-top: 12px;
    border-top: 1px solid var(--ds-border);
    color: var(--ds-muted);
    font-size: 0.75rem;
  }

  .recipe-card__difficulty {
    margin-left: auto;
    color: var(--ds-teal);
    font-weight: 600;
    text-transform: capitalize;
  }

  @media (max-width: 576px) {
    .recipe-card__content {
      padding: 13px;
    }

    .recipe-card__title {
      font-size: 1.15rem;
    }

    .recipe-card__details {
      gap: 8px;
    }
  }
</style>
