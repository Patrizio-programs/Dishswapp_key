---
// FoodCards.astro
// Bootstrap-styled 3-column card component based on the visual example.
// Uses Bootstrap 5 via CDN for styling. Drop this file into any Astro project
// (e.g. src/components/FoodCards.astro) and import it from a page.

const cards = [
  {
    cuisine: "Italian",
    slug: "italian",
    description: "Slow ragù, bright pesto, perfect pasta.",
    badge: null,
    color: "#F5C6C6",
  },
  {
    cuisine: "Mexican",
    slug: "mexican",
    description: "Tinga, mole, tacos, the works.",
    badge: null,
    color: "#C8A47E",
  },
  {
    cuisine: "Asian",
    slug: "asian",
    description: "Maple salmon, miso ramen, congee.",
    badge: null,
    color: "#BBD3E7",
  },
];
---

<section class="container py-5">
  <div class="row g-4">
    <div class="col-auto d-md-none cuisine-all"><a href="/recipes/">All</a></div>
    {cards.map((card) => (
      <div class="col-12 col-md-4">
        <a
  href={`/cuisine/${card.slug}/`}
  class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden text-decoration-none"
>
          <div
            class="card-img-top d-flex align-items-start justify-content-end p-3"
            style={`background-color:${card.color};height:220px;`}
          >
            {card.badge && (
              <span
                class="badge rounded-pill px-3 py-2"
                style="background-color:#E67E22;color:#fff;"
              >
                {card.badge}
              </span>
            )}
          </div>
          <div class="card-body p-4">
            <h3 class="card-title h5 mb-2 fw-semibold">{card.cuisine}</h3>
            <p class="card-text text-muted mb-0">{card.description}</p>
          </div>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  /* Local tweaks so the component looks right even before Bootstrap loads.
     Bootstrap's grid + utilities do the heavy lifting; these are fallbacks. */
  .card-img-top {
    width: 100%;
    height: auto !important;
    aspect-ratio: 4 / 3;
  }

  .row.g-4 > div:nth-child(2) .card-img-top {
    background-color: var(--ds-pink-soft) !important;
  }

  .row.g-4 > div:nth-child(3) .card-img-top {
    background-color: var(--ds-oat) !important;
  }

  .row.g-4 > div:nth-child(4) .card-img-top {
    background-color: var(--ds-teal-tint) !important;
  }

  .row.g-4 .card {
    border: 1px solid var(--ds-border) !important;
    border-radius: var(--ds-radius-md) !important;
    box-shadow: var(--ds-shadow-sm) !important;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .row.g-4 .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--ds-shadow-md) !important;
  }

  .row.g-4 .card-title {
    color: var(--ds-dark);
    font: 600 1.375rem/1.27 var(--ds-heading-font);
  }

  .row.g-4 .card-text {
    color: var(--ds-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  @media (max-width: 767.98px) {
    section.container.py-5 { padding: 12px 0 !important; }
    .row.g-4 { display: flex; flex-wrap: nowrap; gap: 8px; margin: 0; overflow-x: auto; padding: 0 2px 5px; scrollbar-width: none; }
    .row.g-4::-webkit-scrollbar { display: none; }
    .row.g-4 > div { width: auto; flex: 0 0 auto; padding: 0; }
    .row.g-4 .card, .row.g-4 .card:hover { display: block; height: auto !important; border: 0 !important; border-radius: 999px !important; background: transparent; box-shadow: none !important; transform: none; }
    .card-img-top, .card-text { display: none !important; }
    .row.g-4 .card-body { padding: 0 !important; }
    .row.g-4 .card-title, .cuisine-all a { display: block; margin: 0 !important; padding: 7px 13px; border: 1px solid var(--ds-pink-soft); border-radius: 999px; background: var(--ds-pink-soft); color: var(--ds-dark); font: 600 .76rem var(--ds-body-font); }
    .row.g-4 .card-title { font-size: .76rem; }
    .cuisine-all a { background: var(--ds-teal); border-color: var(--ds-teal); color: var(--ds-white); }
  }
</style>
