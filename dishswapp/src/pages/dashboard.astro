---
// src/pages/dashboard.astro
// Personal dashboard for signed-in DishSwapp contributors.
//
// What this page does
// --------------------
//   • Reads the signed-in user's recipes from Supabase (table: recipes),
//     filtered server-side by submitted_by = Clerk user ID.
//   • Splits them into:
//       - LIVE   → rendered as cards (reusing the shared RecipeCard.astro)
//       - PENDING → shown as a count only.
//   • Two CTAs: "Add a new recipe" and "Browse all recipes".
//
// Rows are mapped into the same { id, data } shape the old content collection
// produced, so RecipeCard.astro and the template below stay unchanged.

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { supabase, type Recipe } from '../lib/supabase';

// ---- Server-side auth (Clerk Astro) -------------------------------------
const { isAuthenticated } = Astro.locals.auth();

if (!isAuthenticated) {
  return Astro.redirect('/login');
}

const user = await Astro.locals.currentUser();

if (!user) {
  return Astro.redirect('/login');
}

// ---- Pull the user's recipes from Supabase ------------------------------
const { data: rows, error } = await supabase
  .from('recipes')
  .select('*')
  .eq('submitted_by', user.id)
  .order('created_at', { ascending: false });

if (error) {
  console.error('Dashboard query failed:', error);
}

// Map a Supabase row to the shape the old content-collection entries had.
const toEntry = (r: Recipe) => ({
  id: r.slug,
  data: {
    title: r.title,
    description: r.description ?? undefined,
    ingredients: r.ingredients,
    instructions: r.instructions,
    tags: r.tags,
    difficulty: r.difficulty,
    status: r.status,
    author: r.author ?? undefined,
    submittedBy: r.submitted_by,
    image: r.image_url ?? undefined,
    prepTime: r.prep_time ?? undefined,
    cookTime: r.cook_time ?? undefined,
    servings: r.servings ?? undefined,
    notes: r.notes ?? undefined,
  },
});

const userRecipes: Recipe[] = (rows ?? []) as Recipe[];

// LIVE recipes — shown as cards, sorted alphabetically by title
// (matches the sort used on /recipes).
const liveRecipes = userRecipes
  .filter((recipe) => recipe.status === 'live')
  .sort((a, b) => a.title.localeCompare(b.title));


// PENDING recipes — only the count matters.
const pendingCount = userRecipes.filter(
  (recipe) => recipe.status === 'pending'
).length;
const pendingRecipes = userRecipes
  .filter((recipe) => recipe.status === 'pending')
  .sort((a, b) => b.created_at.localeCompare(a.created_at));
const recipeUpdated = Astro.url.searchParams.get('updated') === '1';

const { data: savedRows, error: savedRowsError } = await supabase.from('saved_recipes')
  .select('recipe_id, saved_at').eq('user_id', user.id).order('saved_at', { ascending: false });
if (savedRowsError) console.error('Dashboard saved recipes query failed:', savedRowsError);
const savedOrder = new Map((savedRows ?? []).map((row) => [row.recipe_id, row.saved_at]));
const savedIds = [...savedOrder.keys()];
let savedRecipes: Recipe[] = [];
if (savedIds.length) {
  const { data: savedRecipeRows, error: savedRecipeError } = await supabase.from('recipes')
    .select('*').in('id', savedIds).eq('status', 'live');
  if (savedRecipeError) console.error('Could not load saved recipes:', savedRecipeError);
  savedRecipes = ((savedRecipeRows ?? []) as Recipe[]).sort((a, b) =>
    (savedOrder.get(b.id) ?? '').localeCompare(savedOrder.get(a.id) ?? '')
  );
}
const savedNotice = Astro.url.searchParams.get('saved');

// ---- Display name (same fallback chain as submit-recipe.astro) ----------
const displayName =
  [user.firstName, user.lastName].filter(Boolean).join(' ') ||
  user.username ||
  user.primaryEmailAddress?.emailAddress ||
  'DishSwapp cook';
---

<Layout
  title="Dashboard | DishSwapp"
  description="Your personal DishSwapp kitchen."
  noindex
>
  <Navbar />

  <main class="dashboard">
      <!-- ===================== Header band ===================== -->
      <section class="dash-header">
        <div class="ds-container">
          <p class="ds-eyebrow">YOUR DISHSWAPP KITCHEN</p>

          <h1 class="dash-title">
            Welcome back<span class="dash-title-accent">, {displayName}</span>
          </h1>

          <p class="dash-subtitle">
            Everything you've shared with the community, in one place.
            Live recipes are cookable now; pending ones are waiting on review.
          </p>

          <!-- Two CTAs (§10 button kit). Spice = the one "cook this" moment. -->
          <div class="dash-actions">
            <a class="dash-btn dash-btn--spice" href="/submit-recipe">
              <i class="bi bi-plus-lg"></i>
              Add a new recipe
            </a>
            <a class="dash-btn dash-btn--outline" href="/recipes">
              <i class="bi bi-search"></i>
              Browse all recipes
            </a>
          </div>
        </div>
      </section>

      {recipeUpdated && <p class="dash-updated" role="status"><i class="bi bi-check-circle"></i> Recipe changes saved.</p>}
      {savedNotice === '1' && <p class="dash-updated" role="status"><i class="bi bi-bookmark-check"></i> Recipe added to your saved list.</p>}
      {savedNotice === '0' && <p class="dash-updated" role="status"><i class="bi bi-bookmark"></i> Recipe removed from your saved list.</p>}

      <!-- ===================== Stats band ===================== -->
      <section class="ds-container dash-stats">
        <div class="dash-stat">
          <span class="dash-stat__label">Live recipes</span>
          <span class="dash-stat__value">{liveRecipes.length}</span>
          <span class="dash-stat__caption">
            {liveRecipes.length === 1
              ? 'recipe is cookable on the site'
              : 'recipes are cookable on the site'}
          </span>
        </div>

        <div class="dash-stat dash-stat--pending">
          <span class="dash-stat__badge">In review</span>
          <span class="dash-stat__label">Pending review</span>
          <span class="dash-stat__value">{pendingCount}</span>
          <span class="dash-stat__caption">
            {pendingCount === 1
              ? 'recipe awaiting approval'
              : 'recipes awaiting approval'}
          </span>
        </div>
      </section>

      <!-- ===================== Live recipe grid ===================== -->
      <section class="ds-container dash-grid-section">
        <div class="dash-grid-heading">
          <h2>Your live recipes</h2>
          <p>
            {liveRecipes.length === 0
              ? 'No live recipes yet'
              : liveRecipes.length === 1
                ? '1 recipe live on the site'
                : `${liveRecipes.length} recipes live on the site`}
          </p>
        </div>

        {liveRecipes.length > 0 ? (
          <div class="dash-grid">
            {liveRecipes.map((recipe) => (
              <div class="dash-card">
                <RecipeCard
                  recipe={recipe}
                  href={`/recipes/${recipe.slug}/`}
                  compact
                />

                <div class="recipe-actions">
                  <a href={`/dashboard/edit/${recipe.id}`} class="recipe-action recipe-action--edit"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit recipe</a>
                  <form method="POST" action="/api/delete-recipe" data-confirm={`Delete "${recipe.title}"? This can't be undone.`}>
                    <input type="hidden" name="id" value={recipe.id} />
                    <button type="submit" class="recipe-action recipe-action--delete"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                  </form>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="dash-empty">
            <div class="dash-empty__icon" aria-hidden="true">
              <i class="bi bi-journal-bookmark"></i>
            </div>
            <h3>No recipes yet — your kitchen is quiet.</h3>
            <p>
              Share your first recipe and it'll show up here once it's
              approved. Tap <strong>“Add a new recipe”</strong> above to
              get started.
            </p>
          </div>
        )}
      </section>

      {pendingRecipes.length > 0 && <section class="ds-container pending-section">
        <div class="dash-grid-heading">
          <h2>Your pending recipes</h2>
          <p>These are waiting for review. You can keep editing them while they’re pending.</p>
        </div>
        <div class="pending-list">
          {pendingRecipes.map((recipe) => <article class="pending-item">
            <div><h3>{recipe.title}</h3><p>Submitted {new Date(recipe.created_at).toLocaleDateString()}</p></div>
            <div class="recipe-actions">
              <a href={`/dashboard/edit/${recipe.id}`} class="recipe-action recipe-action--edit"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit recipe</a>
              <form method="POST" action="/api/delete-recipe" data-confirm={`Delete "${recipe.title}"? This can't be undone.`}>
                <input type="hidden" name="id" value={recipe.id} />
                <button type="submit" class="recipe-action recipe-action--delete"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
              </form>
            </div>
          </article>)}
        </div>
      </section>}

      <section class="ds-container saved-section">
        <div class="dash-grid-heading">
          <h2>Your saved recipes</h2>
          <p>{savedRecipes.length} {savedRecipes.length === 1 ? 'recipe saved' : 'recipes saved for later'}</p>
        </div>
        {savedRecipes.length ? <div class="dash-grid">
          {savedRecipes.map((recipe) => <div class="dash-card saved-card">
            <RecipeCard recipe={recipe} href={`/recipes/${recipe.slug}/`} compact />
            <form method="POST" action="/api/saved-recipes">
              <input type="hidden" name="recipe_id" value={recipe.id} />
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="destination" value="dashboard" />
              <button type="submit" class="recipe-action recipe-action--delete"><i class="bi bi-bookmark-x" aria-hidden="true"></i> Remove saved recipe</button>
            </form>
          </div>)}
        </div> : <div class="saved-empty">
          <p>Save a recipe to keep it handy for later.</p>
          <a href="/recipes/" class="dash-btn dash-btn--outline">Browse recipes</a>
        </div>}
      </section>
  </main>

  <Footer />
</Layout>

<script>
  // Ask before deleting.
  document
    .querySelectorAll<HTMLFormElement>('form[data-confirm]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        if (!confirm(form.dataset.confirm)) event.preventDefault();
      });
    });
</script>

<style>
  /* ============================================================
     Dashboard — DishSwapp brand book (v2.0)
     Uses tokens from src/styles.css:
       --ds-cream, --ds-teal, --ds-pink, --ds-spice, --ds-dark,
       --ds-muted, --ds-border,
       --ds-heading-font (Playfair), --ds-body-font (Inter),
       --ds-mono-font (JetBrains Mono),
       --ds-radius-sm/md/lg.
     60/30/10 ratio: cream canvas, teal structure, <10% spice + pink.
  ============================================================ */

  .dashboard {
    min-height: 60vh;
  }

  /* ---------- Header band ---------- */
  .dash-header {
    background: var(--ds-cream);
    padding: 70px 0 50px;
    border-bottom: 1px solid var(--ds-border);
  }

  .dash-title {
    font-family: var(--ds-heading-font);
    font-size: clamp(2.2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--ds-dark);
    margin: 12px 0 18px;
  }

  /* Pink italic accent mirrors the wordmark's "Swapp" and the hero's
     "cook." (§04 / §16). Spice is reserved for the one CTA per page. */
  .dash-title-accent {
    color: var(--ds-pink);
    font-style: italic;
  }

  .dash-subtitle {
    color: var(--ds-muted);
    line-height: 1.7;
    max-width: 620px;
    margin: 0 0 28px;
  }

  /* ---------- CTA buttons (§10 button kit) ---------- */
  .dash-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .dash-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    border-radius: 999px;
    font-family: var(--ds-body-font);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease,
      transform 0.15s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  /* Spice = the one primary CTA on the page (§10). */
  .dash-btn--spice {
    background: var(--ds-spice);
    color: #fff;
    border: none;
    box-shadow: 0 4px 12px rgba(44, 42, 40, 0.12);
  }

  .dash-btn--spice:hover {
    background: #c96a32;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(44, 42, 40, 0.18);
  }

  /* Secondary = outline teal (§10). */
  .dash-btn--outline {
    background: transparent;
    color: var(--ds-teal);
    border: 1.5px solid var(--ds-teal);
  }

  .dash-btn--outline:hover {
    background: var(--ds-teal);
    color: #fff;
  }

  /* ---------- Stats band ---------- */
  .dash-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding-top: 45px;
    padding-bottom: 15px;
  }

  .dash-stat {
    background: #fff;
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-md);
    padding: 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Pending card uses oat as the card-highlight fill (§05 oat role) and a
     small pink badge as the only pink element — keeps the 60/30/10 ratio. */
  .dash-stat--pending {
    background: var(--ds-oat, #EFE5D4);
    border-color: transparent;
  }

  .dash-stat__badge {
    align-self: flex-start;
    background: var(--ds-pink);
    color: #2C2A28;
    font-family: var(--ds-mono-font);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 4px;
  }

  .dash-stat__label {
    font-family: var(--ds-mono-font);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ds-teal);
  }

  .dash-stat--pending .dash-stat__label {
    color: var(--ds-teal);
  }

  .dash-stat__value {
    font-family: var(--ds-heading-font);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ds-dark);
    font-feature-settings: 'tnum' 1;
  }

  .dash-stat__caption {
    font-size: 0.9rem;
    color: var(--ds-muted);
  }

  .dash-stat--pending .dash-stat__caption {
    color: var(--ds-muted);
    opacity: 1;
  }

  /* ---------- Live recipe grid ---------- */
  .dash-grid-section {
    padding-top: 35px;
    padding-bottom: 80px;
  }

  .dash-grid-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .dash-grid-heading h2 {
    font-family: var(--ds-heading-font);
    font-size: 1.9rem;
    color: var(--ds-dark);
    margin: 0;
  }

  .dash-grid-heading p {
    color: var(--ds-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .dash-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  /* ---------- Recipe actions ---------- */
  .dash-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .recipe-actions { display: flex; align-items: center; gap: 10px; width: 100%; }
  .recipe-actions > a, .recipe-actions > form { flex: 1; }
  .recipe-actions form { display: flex; margin: 0; }
  .recipe-action { width: 100%; min-height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 12px; border: 1px solid transparent; border-radius: var(--ds-radius-sm); font: inherit; font-size: .9rem; font-weight: 600; line-height: 1; text-decoration: none; cursor: pointer; }
  .recipe-action--edit { background: var(--ds-teal); color: white; }
  .recipe-action--edit:hover, .recipe-action--edit:focus-visible { background: #315f68; color: white; }
  .recipe-action--delete { border-color: #d8a5a0; background: white; color: #9c302a; }
  .recipe-action--delete:hover, .recipe-action--delete:focus-visible { border-color: #9c302a; background: #fff3f2; color: #852720; }

  .pending-section { padding-bottom: 70px; }
  .saved-section { padding-bottom: 80px; }
  .saved-card > form { margin: 0; }
  .saved-empty { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px; border: 1px dashed var(--ds-border); border-radius: var(--ds-radius-md); background: var(--ds-cream); }
  .saved-empty p { margin: 0; color: var(--ds-muted); }
  .pending-list { display: grid; gap: 10px; }
  .pending-item { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 18px 20px; background: white; border: 1px solid var(--ds-border); border-radius: var(--ds-radius-md); }
  .pending-item h3 { margin: 0 0 4px; color: var(--ds-dark); font: 700 1.15rem var(--ds-heading-font); }
  .pending-item p { margin: 0; color: var(--ds-muted); font-size: .88rem; }
  .pending-item .recipe-actions { width: auto; min-width: 220px; }
  .dash-updated { width: min(1100px, calc(100% - 40px)); margin: 20px auto 0; padding: 14px 18px; color: #276243; background: #e3f4e9; border-radius: var(--ds-radius-sm); }

  /* ---------- Empty state ---------- */
  .dash-empty {
    text-align: center;
    background: var(--ds-cream);
    border: 1px dashed var(--ds-border);
    border-radius: var(--ds-radius-lg);
    padding: 60px 30px;
  }

  .dash-empty__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ds-pink);
    color: var(--ds-dark);
    font-size: 1.6rem;
  }

  .dash-empty h3 {
    font-family: var(--ds-heading-font);
    font-size: 1.5rem;
    color: var(--ds-dark);
    margin: 0 0 8px;
  }

  .dash-empty p {
    color: var(--ds-muted);
    margin: 0 auto;
    max-width: 460px;
    line-height: 1.7;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 991px) {
    .dash-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 575px) {
    .dash-header {
      padding: 50px 0 40px;
    }

    .dash-stats {
      grid-template-columns: 1fr;
    }

    .dash-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .pending-item { align-items: flex-start; flex-direction: column; }
    .pending-item .recipe-actions { width: 100%; }
    .saved-empty { align-items: flex-start; flex-direction: column; }
  }
</style>
