---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const posts = await getCollection('posts');
import Navbar from "../components/Navbar.astro"
import CuisineCard from "../components/CuisineCard.astro"
---

<Layout title="DISHSWAPP | HOME" description="Dish Swapp is a platform that allows users to share and discover recipes from around the world.">
<Navbar></Navbar>
<Hero></Hero>
<CuisineCard></CuisineCard>
<Footer></Footer>
</Layout>
