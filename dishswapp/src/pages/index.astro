---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

// The featured recipe changes with the current month, so render this page per request.
export const prerender = false;

const posts = await getCollection('posts');
import Navbar from "../components/Navbar.astro"
import CuisineCard from "../components/CuisineCard.astro"
import RecipeOfTheMonth from '../components/RecipeOfTheMonth.astro';
---

<Layout
  title="DishSwapp | Collect, collaborate, cook."
  description="DishSwapp is an open-source community where home cooks discover, share and improve recipes from Italian, Mexican, Asian kitchens and beyond."
>
<Navbar></Navbar>
<Hero></Hero>
<CuisineCard></CuisineCard>
<RecipeOfTheMonth />
<Footer></Footer>
</Layout>
