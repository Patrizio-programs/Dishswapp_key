---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const posts = await getCollection('posts');
import Navbar from "../components/Navbar.astro"
import CuisineCard from "../components/CuisineCard.astro"
---

<Layout
  title="DishSwapp | Collect, collaborate, cook."
  description="DishSwapp is an open-source community where home cooks discover, share and improve recipes from Italian, Mexican, Asian kitchens and beyond."
>
<Navbar></Navbar>
<Hero></Hero>
<CuisineCard></CuisineCard>
<Footer></Footer>
</Layout>
