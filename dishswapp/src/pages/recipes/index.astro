
---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');

const sortedRecipes = recipes.sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Layout title="Recipes | DishSwapp">
  <Navbar />

  <main>
    <section class="recipes-header">
      <div class="ds-container">
        <p class="ds-eyebrow">THE DISHSWAPP COLLECTION</p>
        <h1>Explore Recipes</h1>
        <p class="recipes-intro">
          Discover, share and enjoy recipes from different cuisines and kitchens.
        </p>
      </div>
    </section>

    <section class="ds-container recipes-section">
      <div class="recipes-heading">
        <div>
          <h2>All Recipes</h2>
          <p>{sortedRecipes.length} recipes to explore</p>
        </div>
      </div>

      {sortedRecipes.length > 0 ? (
        <div class="recipes-grid">
          {sortedRecipes.map((recipe) => (
            <RecipeCard
  recipe={recipe}
  href={`/recipes/${recipe.id}/`}
/>
          ))}
        </div>
      ) : (
        <div class="empty-recipes">
          <h3>No recipes yet</h3>
          <p>Check back soon for new recipes!</p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .recipes-header {
    background: var(--ds-cream);
    padding: 75px 0 65px;
    text-align: center;
  }

  .recipes-header h1 {
    font-family: var(--ds-heading-font);
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--ds-dark);
    margin: 12px 0;
  }

  .recipes-intro {
    color: var(--ds-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .recipes-section {
    padding-top: 55px;
    padding-bottom: 75px;
  }

  .recipes-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }

  .recipes-heading h2 {
    font-family: var(--ds-heading-font);
    font-size: 2rem;
    margin-bottom: 5px;
  }

  .recipes-heading p {
    color: var(--ds-muted);
    margin: 0;
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .empty-recipes {
    text-align: center;
    padding: 60px 20px;
    background: var(--ds-cream);
    border-radius: var(--ds-radius-md);
  }

  .empty-recipes h3 {
    font-family: var(--ds-heading-font);
  }

  .empty-recipes p {
    color: var(--ds-muted);
    margin-bottom: 0;
  }

  @media (max-width: 991px) {
    .recipes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 575px) {
    .recipes-header {
      padding: 55px 15px;
    }

    .recipes-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
