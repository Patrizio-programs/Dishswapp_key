---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { supabase, type Recipe } from '../../lib/supabase';

const pageSize = 9;
const searchTerm = (Astro.url.searchParams.get('q') ?? '').slice(0, 100).trim();
const selectedCuisine = Astro.url.searchParams.get('cuisine') ?? '';
const requestedDifficulty = Astro.url.searchParams.get('difficulty') ?? '';
const selectedDifficulty = (['easy', 'intermediate', 'hard'] as const).find((value) => value === requestedDifficulty) ?? '';
const requestedPage = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const safeSearch = searchTerm.replace(/[^a-z0-9 -]/gi, ' ').replace(/\s+/g, ' ').trim();

let query = supabase.from('recipes').select('*', { count: 'exact' })
  .eq('status', 'live').order('title', { ascending: true });
if (safeSearch) query = query.or(`title.ilike.%${safeSearch}%,description.ilike.%${safeSearch}%`);
if (selectedCuisine) query = query.contains('tags', [selectedCuisine]);
if (selectedDifficulty) query = query.eq('difficulty', selectedDifficulty);

const { data, error, count } = await query.range((requestedPage - 1) * pageSize, requestedPage * pageSize - 1);
if (error) console.error('Failed to fetch recipes:', error);

const recipes: Recipe[] = data ?? [];
const totalRecipes = count ?? 0;
const totalPages = Math.max(1, Math.ceil(totalRecipes / pageSize));
const currentPage = Math.min(requestedPage, totalPages);
if (requestedPage > totalPages) {
  const redirectUrl = new URL(Astro.url);
  redirectUrl.searchParams.set('page', String(totalPages));
  return Astro.redirect(`${redirectUrl.pathname}${redirectUrl.search}`);
}

// Fetch only lightweight tag metadata for the cuisine selector.
const { data: tagRows, error: tagError } = await supabase.from('recipes').select('tags').eq('status', 'live');
if (tagError) console.error('Failed to fetch recipe tags:', tagError);
const allTags = [...new Set((tagRows ?? []).flatMap((row) => row.tags ?? []))].sort((a, b) => a.localeCompare(b));
if (selectedCuisine && !allTags.includes(selectedCuisine)) allTags.push(selectedCuisine);

const makePageHref = (page: number) => {
  const url = new URL(Astro.url);
  url.searchParams.set('page', String(page));
  return `${url.pathname}${url.search}`;
};
---

<Layout
  title="Explore Recipes | DishSwapp"
  description="Browse community-shared recipes across cuisines and kitchens on DishSwapp. Discover, cook and share recipes from around the world."
>
  <Navbar />
  <main>
    <section class="recipes-header">
      <div class="ds-container">
        <p class="ds-eyebrow">THE DISHSWAPP COLLECTION</p>
        <h1>Explore Recipes</h1>
        <p class="recipes-intro">Discover, share and enjoy recipes from different cuisines and kitchens.</p>
      </div>
    </section>

    <section class="ds-container recipes-section">
      <nav class="mobile-cuisine-chips" aria-label="Popular recipe categories">
        <a href="/recipes/" class:list={['cuisine-chip', !selectedCuisine && 'is-active']}>All</a>
        {allTags.slice(0, 4).map((tag) => <a href={`/recipes/?cuisine=${encodeURIComponent(tag)}`} class:list={['cuisine-chip', selectedCuisine === tag && 'is-active']}>{tag}</a>)}
        {allTags.length > 4 && <a href="#cuisine-filter" class="cuisine-chip more-chip">+{allTags.length - 4}</a>}
      </nav>
      <div class="recipes-heading">
        <div><h2>All Recipes</h2><p aria-live="polite">{totalRecipes} {totalRecipes === 1 ? 'recipe' : 'recipes'} found</p></div>
      </div>

      <form class="recipe-filters" method="get" action="/recipes/">
        <input type="hidden" name="page" value="1" />
        <div class="filter-search">
          <label for="recipe-search">Search recipes</label>
          <div class="search-input-wrapper"><i class="bi bi-search"></i><input type="search" id="recipe-search" name="q" placeholder="Search by name or description..." value={searchTerm} maxlength="100" /></div>
        </div>
        <div class="filter-select">
          <label for="cuisine-filter">Cuisine</label>
          <select id="cuisine-filter" name="cuisine">
            <option value="">All cuisines</option>
            {allTags.map((tag) => <option value={tag} selected={selectedCuisine === tag}>{tag}</option>)}
          </select>
        </div>
        <div class="filter-select">
          <label for="difficulty-filter">Difficulty</label>
          <select id="difficulty-filter" name="difficulty">
            <option value="" selected={!selectedDifficulty}>All difficulties</option>
            <option value="easy" selected={selectedDifficulty === 'easy'}>Easy</option>
            <option value="intermediate" selected={selectedDifficulty === 'intermediate'}>Intermediate</option>
            <option value="hard" selected={selectedDifficulty === 'hard'}>Hard</option>
          </select>
        </div>
        <div class="filter-actions"><button type="submit">Apply filters</button><a href="/recipes/">Clear</a></div>
      </form>

      {error ? <div class="empty-recipes"><h3>Recipes are temporarily unavailable</h3><p>Please try again in a moment.</p></div>
        : recipes.length ? <div class="recipes-grid">{recipes.map((recipe) => <RecipeCard recipe={recipe} href={`/recipes/${recipe.slug}/`} compact />)}</div>
          : <div class="empty-recipes"><h3>{searchTerm || selectedCuisine || selectedDifficulty ? 'No matching recipes' : 'No recipes yet'}</h3><p>{searchTerm || selectedCuisine || selectedDifficulty ? 'Try different search terms or clear your filters.' : 'Check back soon for new recipes!'}</p></div>}

      {totalPages > 1 && <nav class="pagination" aria-label="Recipe pages">
        {currentPage > 1 ? <a href={makePageHref(currentPage - 1)}><i class="bi bi-chevron-left"></i> Previous</a> : <span class="page-disabled"><i class="bi bi-chevron-left"></i> Previous</span>}
        <span>Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages ? <a href={makePageHref(currentPage + 1)}>Next <i class="bi bi-chevron-right"></i></a> : <span class="page-disabled">Next <i class="bi bi-chevron-right"></i></span>}
      </nav>}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .recipes-header { background: var(--ds-cream); padding: 75px 0 65px; text-align: center; }
  .recipes-header h1 { font-family: var(--ds-heading-font); font-size: clamp(2.5rem, 5vw, 4rem); color: var(--ds-dark); margin: 12px 0; }
  .recipes-intro { color: var(--ds-muted); max-width: 560px; margin: 0 auto; line-height: 1.7; }
  .recipes-section { padding-top: 55px; padding-bottom: 75px; }
  .recipes-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
  .recipes-heading h2 { font-family: var(--ds-heading-font); font-size: 2rem; margin-bottom: 5px; }
  .recipes-heading p { color: var(--ds-muted); margin: 0; }
  .recipe-filters { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 15px; align-items: end; padding: 22px; margin-bottom: 30px; background: var(--ds-cream); border-radius: var(--ds-radius-md); }
  .recipe-filters label { display: block; font-size: .85rem; font-weight: 600; color: var(--ds-dark); margin-bottom: 7px; }
  .search-input-wrapper { position: relative; }
  .search-input-wrapper i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--ds-muted); }
  .recipe-filters input, .recipe-filters select { width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--ds-border); border-radius: var(--ds-radius-sm); background: white; color: var(--ds-dark); font: inherit; font-size: .9rem; }
  .recipe-filters input { padding-left: 38px; }
  .recipe-filters input:focus, .recipe-filters select:focus { outline: 2px solid var(--ds-teal); outline-offset: 2px; }
  .filter-actions { display: flex; align-items: center; gap: 12px; white-space: nowrap; }
  .filter-actions button, .filter-actions a { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 10px 14px; border: 1px solid var(--ds-teal); border-radius: var(--ds-radius-sm); background: transparent; color: var(--ds-teal); font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; }
  .filter-actions button:hover { background: var(--ds-teal); color: white; }
  .recipes-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 25px; }
  .mobile-cuisine-chips { display: none; }
  .empty-recipes { text-align: center; padding: 60px 20px; background: var(--ds-cream); border-radius: var(--ds-radius-md); }
  .empty-recipes h3 { font-family: var(--ds-heading-font); }
  .empty-recipes p { color: var(--ds-muted); margin-bottom: 0; }
  .pagination { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 45px; }
  .pagination a, .pagination .page-disabled { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1px solid var(--ds-teal); border-radius: var(--ds-radius-sm); background: white; color: var(--ds-teal); font-weight: 600; text-decoration: none; }
  .pagination a:hover { background: var(--ds-teal); color: white; }
  .pagination .page-disabled { opacity: .45; }
  @media (max-width: 991px) { .recipe-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } .recipes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767.98px) {
    .recipes-header { padding: 26px 15px 18px; }
    .recipes-header h1 { margin: 0; font-size: 1.8rem; }
    .recipes-intro { display: none; }
    .recipes-section { padding-top: 14px; }
    .mobile-cuisine-chips { display: flex; gap: 8px; overflow-x: auto; margin: 0 -4px 14px; padding: 2px 4px 5px; scrollbar-width: none; }
    .mobile-cuisine-chips::-webkit-scrollbar { display: none; }
    .cuisine-chip { flex: none; padding: 6px 12px; border-radius: 999px; background: white; color: var(--ds-teal); font-size: .75rem; white-space: nowrap; }
    .cuisine-chip.is-active, .cuisine-chip.more-chip { background: #fce6dd; color: #8c4939; }
    .recipes-heading { margin-bottom: 12px; }
    .recipes-heading h2 { font-size: 1.4rem; }
    .recipe-filters { grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px; margin-bottom: 16px; }
    .filter-search { grid-column: 1 / -1; }
    .recipe-filters label { font-size: .75rem; margin-bottom: 4px; }
    .recipe-filters input, .recipe-filters select { min-height: 40px; padding-block: 7px; font-size: .82rem; }
    .filter-actions { grid-column: 1 / -1; justify-content: space-between; }
    .filter-actions button, .filter-actions a { min-height: 38px; padding: 7px 12px; font-size: .82rem; }
    .recipes-grid { grid-template-columns: 1fr; gap: 10px; }
    .pagination { gap: 10px; margin-top: 24px; }
    .pagination a, .pagination .page-disabled { padding: 9px 12px; font-size: .82rem; }
  }
</style>
