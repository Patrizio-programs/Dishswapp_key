
---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { supabase, type Recipe } from '../../lib/supabase';

const { data, error } = await supabase
  .from('recipes')
  .select('*')
  .eq('status', 'live')
  .order('title', { ascending: true });

if (error) {
  console.error('Failed to fetch recipes:', error);
}

const recipes: Recipe[] = data ?? [];

const liveRecipes = recipes;

const sortedRecipes = liveRecipes;

const allTags = [
  ...new Set(
    liveRecipes.flatMap((recipe) => recipe.tags ?? [])
  ),
].sort((a, b) => a.localeCompare(b));
---

<Layout
  title="Explore Recipes | DishSwapp"
  description={`Browse ${liveRecipes.length} community-shared recipe${liveRecipes.length === 1 ? '' : 's'}${allTags.length ? ` across ${allTags.length} cuisine${allTags.length === 1 ? '' : 's'} and tags` : ''} on DishSwapp. Discover, cook and share recipes from different kitchens around the world.`}
>
  <Navbar />

  <main>
    <section class="recipes-header">
      <div class="ds-container">
        <p class="ds-eyebrow">THE DISHSWAPP COLLECTION</p>
        <h1>Explore Recipes</h1>
        <p class="recipes-intro">
          Discover, share and enjoy recipes from different cuisines and kitchens.
        </p>
      </div>
    </section>

    <section class="ds-container recipes-section">

      <div class="recipes-heading">
        <div>
          <h2>All Recipes</h2>
          <p id="recipe-count" aria-live="polite">
            {sortedRecipes.length} recipes to explore
          </p>
        </div>
      </div>

      {sortedRecipes.length > 0 ? (
        <>
          <div class="recipe-filters">

            <div class="filter-search">
              <label for="recipe-search">Search recipes</label>
              <div class="search-input-wrapper">
                <i class="bi bi-search"></i>
                <input
                  type="search"
                  id="recipe-search"
                  placeholder="Search by name or ingredient..."
                />
              </div>
            </div>

            <div class="filter-select">
              <label for="cuisine-filter">Cuisine</label>
              <select id="cuisine-filter">
                <option value="all">All cuisines</option>
                {allTags.map((tag) => (
                  <option value={tag.toLowerCase()}>{tag}</option>
                ))}
              </select>
            </div>

            <div class="filter-select">
              <label for="difficulty-filter">Difficulty</label>
              <select id="difficulty-filter">
                <option value="all">All difficulties</option>
                <option value="easy">Easy</option>
                <option value="intermediate">Intermediate</option>
                <option value="hard">Hard</option>
              </select>
            </div>

            <button type="button" id="clear-filters">
              Clear filters
            </button>

          </div>

          <div class="recipes-grid" id="recipes-grid">
            {sortedRecipes.map((recipe) => {
              const searchableContent = [
  recipe.title,
  recipe.description ?? '',
  ...(recipe.ingredients ?? []),
  ...(recipe.tags ?? []),
].join(' ').toLowerCase();

const tags = (recipe.tags ?? [])
  .map((tag) => tag.toLowerCase())
  .join('|');

              return (
                <div
                  class="recipe-item"
                  data-search={searchableContent}
                  data-tags={tags}
                  data-difficulty={recipe.difficulty ?? 'none'}
                >
                  <RecipeCard
                    recipe={recipe}
                    href={`/recipes/${recipe.slug}/`}
                  />
                </div>
              );
            })}
          </div>

<nav class="pagination" id="recipe-pagination" aria-label="Recipe pages" hidden>
  <button type="button" id="previous-page" disabled>
    <i class="bi bi-chevron-left"></i>
    Previous
  </button>

  <span id="page-info">Page 1 of 1</span>

  <button type="button" id="next-page">
    Next
    <i class="bi bi-chevron-right"></i>
  </button>
</nav>


          <div class="no-results" id="no-results" hidden>
            <h3>No matching recipes</h3>
            <p>Try changing your search or filters.</p>
          </div>
        </>
      ) : (
        <div class="empty-recipes">
          <h3>No recipes yet</h3>
          <p>Check back soon for new recipes!</p>
        </div>
      )}

    </section>
  </main>

  <Footer />
</Layout>

<script>
  
const searchInput = document.querySelector('#recipe-search');
const cuisineFilter = document.querySelector('#cuisine-filter');
const difficultyFilter = document.querySelector('#difficulty-filter');
const clearButton = document.querySelector('#clear-filters');

const recipeItems = Array.from(
  document.querySelectorAll('.recipe-item')
);

const recipeCount = document.querySelector('#recipe-count');
const noResults = document.querySelector('#no-results');

const pagination = document.querySelector('#recipe-pagination');
const previousButton = document.querySelector('#previous-page');
const nextButton = document.querySelector('#next-page');
const pageInfo = document.querySelector('#page-info');

const recipesPerPage = 9;

let currentPage = 1;
let filteredRecipes = [];

function renderPage() {
  const totalPages = Math.ceil(
    filteredRecipes.length / recipesPerPage
  );

  const startIndex = (currentPage - 1) * recipesPerPage;
  const endIndex = startIndex + recipesPerPage;

  recipeItems.forEach((item) => {
    item.hidden = true;
  });

  filteredRecipes.slice(startIndex, endIndex).forEach((item) => {
    item.hidden = false;
  });

  if (recipeCount) {
    recipeCount.textContent =
      `${filteredRecipes.length} ${
        filteredRecipes.length === 1 ? 'recipe' : 'recipes'
      } found`;
  }

  if (noResults) {
    noResults.hidden = filteredRecipes.length !== 0;
  }

  if (pagination) {
    pagination.hidden = totalPages <= 1;
  }

  if (pageInfo) {
    pageInfo.textContent =
      `Page ${currentPage} of ${totalPages}`;
  }

  if (previousButton) {
    previousButton.disabled = currentPage === 1;
  }

  if (nextButton) {
    nextButton.disabled = currentPage === totalPages;
  }
}

function filterRecipes() {
  const searchTerm = searchInput.value.trim().toLowerCase();
  const selectedCuisine = cuisineFilter.value;
  const selectedDifficulty = difficultyFilter.value;

  filteredRecipes = recipeItems.filter((item) => {
    const searchableContent = item.dataset.search ?? '';
    const tags = (item.dataset.tags ?? '').split('|');
    const difficulty = item.dataset.difficulty ?? 'none';

    const matchesSearch = searchableContent.includes(searchTerm);

    const matchesCuisine =
      selectedCuisine === 'all' ||
      tags.includes(selectedCuisine);

    const matchesDifficulty =
      selectedDifficulty === 'all' ||
      difficulty === selectedDifficulty;

    return (
      matchesSearch &&
      matchesCuisine &&
      matchesDifficulty
    );
  });

  // Return to the first page whenever filters change.
  currentPage = 1;

  renderPage();
}

searchInput?.addEventListener('input', filterRecipes);
cuisineFilter?.addEventListener('change', filterRecipes);
difficultyFilter?.addEventListener('change', filterRecipes);

clearButton?.addEventListener('click', () => {
  searchInput.value = '';
  cuisineFilter.value = 'all';
  difficultyFilter.value = 'all';

  filterRecipes();
});

previousButton?.addEventListener('click', () => {
  if (currentPage > 1) {
    currentPage--;
    renderPage();
  }
});

nextButton?.addEventListener('click', () => {
  const totalPages = Math.ceil(
    filteredRecipes.length / recipesPerPage
  );

  if (currentPage < totalPages) {
    currentPage++;
    renderPage();
  }
});

// Display the initial recipe page.
filterRecipes();

</script>

<style>
  .recipes-header {
    background: var(--ds-cream);
    padding: 75px 0 65px;
    text-align: center;
  }

  .recipes-header h1 {
    font-family: var(--ds-heading-font);
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--ds-dark);
    margin: 12px 0;
  }

  .recipes-intro {
    color: var(--ds-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .recipes-section {
    padding-top: 55px;
    padding-bottom: 75px;
  }

  .recipes-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }

  .recipes-heading h2 {
    font-family: var(--ds-heading-font);
    font-size: 2rem;
    margin-bottom: 5px;
  }

  .recipes-heading p {
    color: var(--ds-muted);
    margin: 0;
  }

  .recipe-filters {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: 15px;
    align-items: end;
    padding: 22px;
    margin-bottom: 30px;
    background: var(--ds-cream);
    border-radius: var(--ds-radius-md);
  }

  .recipe-filters label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ds-dark);
    margin-bottom: 7px;
  }

  .search-input-wrapper {
    position: relative;
  }

  .search-input-wrapper i {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ds-muted);
  }

  .recipe-filters input,
  .recipe-filters select {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-sm);
    background: white;
    color: var(--ds-dark);
    font: inherit;
    font-size: 0.9rem;
  }

  .recipe-filters input {
    padding-left: 38px;
  }

  .recipe-filters input:focus,
  .recipe-filters select:focus {
    outline: 2px solid var(--ds-teal);
    outline-offset: 2px;
  }

  #clear-filters {
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--ds-teal);
    border-radius: var(--ds-radius-sm);
    background: transparent;
    color: var(--ds-teal);
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  #clear-filters:hover {
    background: var(--ds-teal);
    color: white;
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .recipe-item[hidden] {
    display: none;
  }

  .no-results,
  .empty-recipes {
    text-align: center;
    padding: 60px 20px;
    background: var(--ds-cream);
    border-radius: var(--ds-radius-md);
  }

  .no-results h3,
  .empty-recipes h3 {
    font-family: var(--ds-heading-font);
  }

  .no-results p,
  .empty-recipes p {
    color: var(--ds-muted);
    margin-bottom: 0;
  }

  @media (max-width: 991px) {
    .recipe-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .recipes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 575px) {
    .recipes-header {
      padding: 55px 15px;
    }

    .recipe-filters {
      grid-template-columns: 1fr;
      padding: 16px;
    }

    .recipes-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }


.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 45px;
}

.pagination[hidden] {
  display: none;
}

.pagination button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  border: 1px solid var(--ds-teal);
  border-radius: var(--ds-radius-sm);
  background: white;
  color: var(--ds-teal);
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.pagination button:hover:not(:disabled) {
  background: var(--ds-teal);
  color: white;
}

.pagination button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

#page-info {
  color: var(--ds-muted);
  font-size: 0.9rem;
}

@media (max-width: 575px) {
  .pagination {
    gap: 10px;
  }

  .pagination button {
    padding: 9px 12px;
    font-size: 0.85rem;
  }
}

</style>
