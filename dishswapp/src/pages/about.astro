---
// src/pages/about.astro
// About page — follows the DishSwapp Brand Book v2.0.
//   • Dark-teal hero with the pink circle bleeding off the edge (brand-book cover motif).
//   • Cream reading area: one big Playfair statement, then a lead, then three themed rows.
//   • Body copy in Inter, never Playfair (§07). Headings in Playfair.
//   • Exactly one spice button on the page (§10).
// Uses the --ds-* tokens from src/styles.css; the few brand colours that
// aren't tokens there yet (teal-dark, oat) are defined locally below.

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    heading: 'Recipes you can improve',
    body: 'Unlike other recipe websites, DishSwapp allows you to do more than just browse through a collection of recipes. With our platform, you can interact with other foodies by commenting and adding your own recipes to the mix. We know how frustrating it can be when you come across a recipe that doesn’t work out, or when you want to add your own twist to an existing recipe, but you can’t do anything about it. With DishSwapp, that frustration is a thing of the past.',
  },
  {
    heading: 'Show us your attempt',
    body: 'But we don’t stop there. We know that food is not just about taste, but also about presentation. That’s why we allow you to post pictures under recipe posts of your attempt at the recipe. Share your success stories, your tips and tricks, and your challenges. We believe that when you cook a meal, it becomes a part of you, and we want to celebrate that.',
  },
  {
    heading: 'Cooking is better together',
    body: 'At DishSwapp, we value collaboration and community. We believe that cooking should not be a solitary activity, but something that brings people together. That’s why we encourage you to engage with others, to share your knowledge, and to learn from others. With DishSwapp, you’re not just joining a website, you’re joining a community of food lovers who are passionate about sharing their love of food.',
  },
];
---

<Layout
  title="About DishSwapp | Cook together"
  description="DishSwapp is a community where food lovers share recipes, improve each other's dishes and post pictures of their attempts. Cooking is better together."
>
  <Navbar />

  <main class="about">
    <!-- ============ Hero ============ -->
    <section class="about-hero">
      <div class="about-hero__circle" aria-hidden="true"></div>

      <div class="ds-container about-hero__inner">
        <p class="about-hero__eyebrow">About DishSwapp</p>
        <h1>Cook together.</h1>
      </div>
    </section>

    <!-- ============ Statement + lead ============ -->
    <section class="ds-container about-intro">
      <p class="about-statement">
        We believe that food is more than just sustenance; it’s an experience
        that brings people together.
      </p>
      <p class="about-lead">
        That’s why we created DishSwapp — a platform where food lovers can come
        together, share their recipes, and try out new ones.
      </p>
    </section>

    <!-- ============ Themed rows ============ -->
    <section class="ds-container about-rows">
      {sections.map((section) => (
        <div class="about-row">
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
        </div>
      ))}
    </section>

    <!-- ============ Closing call to action ============ -->
    <section class="ds-container">
      <div class="about-cta">
        <div class="about-cta__text">
          <h2>Let’s cook something good together.</h2>
          <p>Browse what the community has shared, or add a recipe of your own.</p>
        </div>

        <div class="about-cta__actions">
          <a href="/recipes" class="ds-button-primary">Start exploring</a>
          <a href="/submit-recipe" class="about-btn-outline">Share a recipe</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about {
    --about-teal-dark: #2a535c;
    --about-teal-tint: #e5edef;
    --about-oat: #efe5d4;
    --about-ink: #2c2a28;
  }

  /* ---------- Hero ---------- */
  .about-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--about-teal-dark);
    padding-block: 88px 96px;
  }

  .about-hero__circle {
    position: absolute;
    top: 50%;
    right: -90px;
    width: clamp(220px, 34vw, 440px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    border-radius: 50%;
    background-color: var(--ds-pink);
  }

  .about-hero__inner {
    position: relative; /* keeps the text above the circle */
  }

  .about-hero__eyebrow {
    margin: 0 0 18px;
    font-family: var(--ds-mono-font);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--about-teal-tint);
  }

  .about-hero h1 {
    margin: 0;
    max-width: 8ch;
    font-family: var(--ds-heading-font);
    font-size: clamp(3.25rem, 9vw, 6rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.02;
    color: #fff;
  }

  /* ---------- Statement + lead ---------- */
  .about-intro {
    padding-top: 80px;
    padding-bottom: 64px;
  }

  .about-statement {
    max-width: 22em;
    margin: 0;
    font-family: var(--ds-heading-font);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--about-ink);
  }

  .about-lead {
    max-width: 38rem;
    margin: 28px 0 0;
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--ds-dark);
  }

  /* ---------- Themed rows ---------- */
  .about-rows {
    border-bottom: 1px solid var(--ds-border);
  }

  .about-row {
    padding-block: 44px;
    border-top: 1px solid var(--ds-border);
  }

  .about-row h2 {
    margin: 0 0 16px;
    font-family: var(--ds-heading-font);
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--about-ink);
  }

  .about-row p {
    margin: 0;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ds-dark);
  }

  /* ---------- Closing CTA ---------- */
  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px 40px;
    margin-block: 72px 88px;
    padding: 40px;
    background-color: var(--about-oat);
    border-radius: var(--ds-radius-lg);
  }

  .about-cta__text {
    max-width: 30rem;
  }

  .about-cta h2 {
    margin: 0 0 8px;
    font-family: var(--ds-heading-font);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--about-ink);
  }

  .about-cta p {
    margin: 0;
    color: var(--ds-dark);
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .about-btn-outline {
    display: inline-block;
    padding: 11px 24px;
    border: 1.5px solid var(--ds-teal);
    border-radius: 999px;
    background: transparent;
    font-weight: 600;
    color: var(--ds-teal);
    transition: background-color 0.2s ease;
  }

  .about-btn-outline:hover {
    background-color: var(--about-teal-tint);
    color: var(--ds-teal);
  }

  .ds-button-primary:focus-visible,
  .about-btn-outline:focus-visible {
    outline: 3px solid var(--ds-teal);
    outline-offset: 3px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .about-hero {
      padding-block: 120px 56px; /* leaves room for the circle above the text */
    }

    .about-hero__circle {
      top: -70px;
      right: -70px;
      width: 220px;
      transform: none;
    }

    .about-intro {
      padding-top: 56px;
      padding-bottom: 40px;
    }

    .about-row {
      padding-block: 32px;
    }

    .about-cta {
      padding: 28px 24px;
      margin-block: 48px 64px;
    }

    .about-cta__actions {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-btn-outline,
    .ds-button-primary {
      transition: none;
      transform: none;
    }
  }
</style>