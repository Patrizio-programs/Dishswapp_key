---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Show } from "@clerk/astro/components";

const { isAuthenticated } = Astro.locals.auth();

const user = isAuthenticated
  ? await Astro.locals.currentUser()
  : null;

// Get the best available display name
const authorName = user
  ? [
      user.firstName,
      user.lastName,
    ].filter(Boolean).join(" ") ||
    user.username ||
    user.primaryEmailAddress?.emailAddress ||
    "DishSwapp member"
  : "";
---

<Layout title="Submit a Recipe">
  <Navbar />

  <Show when="signed-in">
    <div>
      <main class="submit-page">
    <div class="submit-container">

      <div class="submit-heading">
        <span class="eyebrow">SHARE YOUR FOOD</span>
        <h1>Share your recipe</h1>
        <p>
          Have a recipe worth sharing? Add it to DishSwapp and let others
          discover something delicious.
        </p>
      </div>

      <form
        id="recipe-form"
        action="/api/recipes"
        method="POST"
        enctype="multipart/form-data"
      >

        <section class="form-section">
          <h2>Recipe details</h2>

          <div class="form-group">
            <label for="title">Recipe title *</label>
            <input
              type="text"
              id="title"
              name="title"
              placeholder="e.g. Creamy Garlic Chicken"
              required
              maxlength="100"
            />
          </div>

          <div class="form-group">
            <label for="description">Short description</label>
            <textarea
              id="description"
              name="description"
              rows="3"
              placeholder="Tell us a little about your recipe..."
            ></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="tags">Cuisine / Tags</label>
              <input
                type="text"
                id="tags"
                name="tags"
                placeholder="Italian, Caribbean, Asian"
              />
              <small>Separate tags with commas.</small>
            </div>

            <div class="form-group">
              <label for="difficulty">Difficulty</label>
              <select id="difficulty" name="difficulty">
                <option value="none">Not specified</option>
                <option value="easy">Easy</option>
                <option value="intermediate">Intermediate</option>
                <option value="hard">Hard</option>
              </select>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>Ingredients and instructions</h2>

          <div class="form-group">
            <label for="ingredients">Ingredients *</label>
            <textarea
              id="ingredients"
              name="ingredients"
              rows="7"
              placeholder={"2 chicken breasts\n2 cloves garlic\n1 cup cream\nSalt and pepper"}
              required
            ></textarea>
            <small>Enter each ingredient on a separate line.</small>
          </div>

          <div class="form-group">
            <label for="instructions">Instructions *</label>
            <textarea
              id="instructions"
              name="instructions"
              rows="8"
              placeholder={"Season the chicken.\nHeat oil in a pan.\nCook the chicken until done."}
              required
            ></textarea>
            <small>Enter each cooking step on a separate line.</small>
          </div>
        </section>

        <section class="form-section">
          <h2>Additional information</h2>

          <div class="form-row three-columns">
            <div class="form-group">
              <label for="prepTime">Prep time (minutes)</label>
              <input
                type="number"
                id="prepTime"
                name="prepTime"
                min="1"
                placeholder="15"
              />
            </div>

            <div class="form-group">
              <label for="cookTime">Cook time (minutes)</label>
              <input
                type="number"
                id="cookTime"
                name="cookTime"
                min="1"
                placeholder="30"
              />
            </div>

            <div class="form-group">
              <label for="servings">Servings</label>
              <input
                type="number"
                id="servings"
                name="servings"
                min="1"
                placeholder="4"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="notes">Additional notes</label>
            <textarea
              id="notes"
              name="notes"
              rows="3"
              placeholder="Any tips, substitutions or helpful information?"
            ></textarea>
          </div>

          <div class="form-group">
            <label for="image">Recipe image</label>
            <input
              type="file"
              id="image"
              name="image"
              accept="image/jpeg,image/png,image/webp"
            />
            <small>Upload a JPG, PNG or WebP image.</small>
          </div>
        </section>

        <section class="form-section author-section">
          <h2>Submission information</h2>

          <div class="form-group">
            <label for="author">Submitted by</label>
            <input
              type="text"
              id="author"
              value={authorName}
              disabled
            />
            <small>Your name comes from your DishSwapp account.</small>
          </div>
        </section>

        <div class="submit-actions">
          <p>
            Your recipe will be reviewed by the DishSwapp team before
            appearing publicly.
          </p>
          <button type="submit">Submit recipe</button>
        </div>

      </form>
    </div>
  </main>
    </div>

    <div slot="fallback">
      <script is:inline>
        window.location.replace("/login");
      </script>
    </div>
  </Show>

  <Footer />
</Layout>

<style>
  /* ===== Submit Recipe — visual polish only (no markup / logic changes) ===== */

  .submit-page {
    background-color: var(--ds-cream);
    min-height: calc(100vh - 80px);
    padding-block: 56px 80px;
  }

  .submit-container {
    width: min(100% - 48px, 820px);
    margin-inline: auto;
  }

  /* ---------- Hero ---------- */
  .submit-heading {
    text-align: center;
    margin-bottom: 48px;
  }

  .submit-heading .eyebrow {
    display: inline-block;
    font-family: var(--ds-mono-font);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ds-teal);
    margin-bottom: 14px;
  }

  .submit-heading h1 {
    font-family: var(--ds-heading-font);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    margin: 0 0 14px;
    color: var(--ds-dark);
  }

  .submit-heading p {
    font-size: 1.05rem;
    color: var(--ds-muted);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ---------- Section cards ---------- */
  #recipe-form .form-section {
    background-color: var(--ds-white);
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-lg);
    padding: 32px;
    margin-bottom: 24px;
  }

  #recipe-form .form-section h2 {
    font-family: var(--ds-heading-font);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 24px;
    color: var(--ds-dark);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ds-border);
  }

  /* ---------- Form groups ---------- */
  .form-group {
    margin-bottom: 20px;
  }

  .form-group:last-child {
    margin-bottom: 0;
  }

  .form-group label {
    display: block;
    font-family: var(--ds-body-font);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ds-dark);
    margin-bottom: 8px;
  }

  .form-group small {
    display: block;
    font-size: 0.78rem;
    color: var(--ds-muted);
    margin-top: 6px;
    line-height: 1.4;
  }

  /* ---------- Inputs ---------- */
  .form-group input[type="text"],
  .form-group input[type="number"],
  .form-group input[type="file"],
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 11px 14px;
    font-family: var(--ds-body-font);
    font-size: 0.95rem;
    color: var(--ds-dark);
    background-color: var(--ds-cream);
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #a8a8a4;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--ds-teal);
    background-color: var(--ds-white);
    box-shadow: 0 0 0 3px rgba(61, 113, 124, 0.12);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 84px;
    line-height: 1.55;
  }

  /* ---------- File input ---------- */
  .form-group input[type="file"] {
    padding: 9px 12px;
    background-color: var(--ds-white);
    cursor: pointer;
  }

  .form-group input[type="file"]::file-selector-button {
    padding: 6px 14px;
    margin-right: 12px;
    background-color: var(--ds-teal);
    color: var(--ds-white);
    border: none;
    border-radius: 999px;
    font-family: var(--ds-body-font);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .form-group input[type="file"]::file-selector-button:hover {
    background-color: #2f5a64;
  }

  /* ---------- Disabled author field ---------- */
  .form-group input:disabled {
    background-color: #f3efe8;
    color: var(--ds-muted);
    cursor: not-allowed;
  }

  /* ---------- Form rows ---------- */
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form-row.three-columns {
    grid-template-columns: repeat(3, 1fr);
  }

  /* ---------- Submit actions ---------- */
  .submit-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 8px;
    padding: 28px 32px;
    background-color: var(--ds-white);
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-lg);
  }

  .submit-actions p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ds-muted);
    max-width: 380px;
    line-height: 1.5;
  }

  .submit-actions button[type="submit"] {
    padding: 13px 32px;
    font-family: var(--ds-body-font);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ds-white);
    background-color: var(--ds-spice);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .submit-actions button[type="submit"]:hover {
    background-color: #c96832;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(224, 122, 59, 0.28);
  }

  .submit-actions button[type="submit"]:active {
    transform: translateY(0);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 720px) {
    .submit-page {
      padding-block: 36px 56px;
    }

    .submit-heading {
      margin-bottom: 32px;
    }

    #recipe-form .form-section,
    .submit-actions {
      padding: 22px;
    }

    .form-row,
    .form-row.three-columns {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .submit-actions {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .submit-actions p {
      max-width: 100%;
    }

    .submit-actions button[type="submit"] {
      width: 100%;
    }
  }
</style>